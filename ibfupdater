	echo "	    * -V, --version"
	echo "	    * -M, --manual"
	echo "	    * -h, --help"
	echo ""
	echo "	Example:"
	echo "	    $ ${PROGRAM_NAME} --curl-options '--user myuser1:secret' --output foo.dat http://example.org/list.dat"
	echo ""
