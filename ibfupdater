##
# Prints a message to stdout when verbose mode is enabled.
print_verbose() {
	[[ ${config[verbose]} -ne 1 ]] && return

	printf '%s\n' "$@"
}

print_version() {
	echo "$PROGRAM_NAME v$PROGRAM_VERSION"
}


main "$@"
