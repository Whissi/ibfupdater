	echo ""
	echo "--quiet"
	echo "	Suppresses normal output. Useful for cron jobs. Errors are still written to stderr."
	echo ""
	echo "--user-agent <agent string>"
	echo "	Sets the cURL user agent."
	echo ""
	echo "--verbose"
	echo "	Enables verbose output explaining cache decisions, transfers, content comparisons, backups"
	echo "	and file publication. Cannot be combined with ‘--quiet’."
	echo ""
	echo "Parameters:"
	echo "==========="
	echo "--output <file>"
	echo "	The path including the filename where the downloaded file should be stored."
	echo "	The directory must already exist and be writable. The output must be a regular file or a new name."
	echo "	Symlinks and special files are rejected, as are names ending in ‘.’, ‘ibfu-meta’ or ‘ibfu-lock’."
	echo "	Updates to the same output wait on ‘.<file>.ibfu-lock’; do not remove this persistent lock file."
