	echo "	(‘.<file>.${config[meta_suffix]}’) and associated with the request and the local file."
	echo "	Missing, outdated or incompatible meta data causes an unconditional download."
	echo ""
	echo "--force"
	echo "	Forces a download without conditional cache validation, even when a cached version exists."
	echo "	Identical content still leaves the current file and its backups unchanged."
	echo ""
	echo "--keep <num>"
	echo "	Sets the number of previous, different versions you want to keep (1 to 2147483647)."
	echo "	When changed content is installed, the previous file is preserved as ‘<file>.1’."
	echo "	Older versions follow as ‘<file>.2’, etc. Gaps are compacted and excess versions removed."
	echo "	Unchanged content does not rotate backups. Without this option, existing backups are left alone."
	echo ""
	echo "--keep-working-dir"
	echo "	When set, $PROGRAM_NAME won't remove the working directory at the end."
	echo "	Useful for debugging. The private working directory is created inside the output directory."
	echo ""
	echo "--logger"
	echo "	Enables the usage of ‘logger’. Logs summaries of successful or unsuccessful file updates"
